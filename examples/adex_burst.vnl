# Пачка вместо одного спайка: адаптивный экспоненциальный LIF (point = adex).
#
# Пример, а не паттерн библиотеки: показывается свойство одной клетки, а в
# библиотеке лежат схемы. Схема здесь -- самая простая, какая позволяет
# сравнить два вида точечной модели на одном и том же входе.
#
# Один источник (IN) раздаёт три коротких толчка двум клеткам. LIF и BURST
# отличаются только видом модели и её параметрами; вход, вес, задержка и
# рецептор у них одинаковы.
#
# LIF так не умеет по устройству уравнения. После разряда его потенциал
# приравнивается к v_reset, и вернуть клетку к порогу может только новый вход:
# второму спайку пачки взяться неоткуда. У adex два новых слагаемых, и пачку
# делают оба:
#
#   * экспоненциальный разгон. Выше v_t = -50 мВ клетка деполяризует себя сама,
#     и v_reset = -43 мВ попадает как раз в эту зону: после разряда клетка снова
#     разгоняется без всякого входа. Это и есть механизм пачки;
#   * ток адаптации w. Каждый разряд добавляет к нему b = 120 пА, и когда
#     накопленного хватает, чтобы перебить разгон, пачка кончается. Он же
#     решает, когда клетка готова к следующей: tau_w = 40 мс.
#
# Чего adex по-прежнему не даёт -- формы самого разряда. Сброс мгновенный:
# потенциал приравнивается к v_reset за один шаг. Настоящая форма спайка живёт
# в уравнениях Ходжкина--Хаксли, и путь к ней -- экспорт на L2.
#
# Что видно на прогоне (ЧИСЛА): на три входных толчка LIF отвечает 3 спайками
# (по одному на толчок, 53.1 / 203.1 / 353.1 мс), BURST -- 15 спайками, тремя
# пачками по 5. Межспайковый интервал внутри пачки 3.4-4.1 мс, между пачками
# 135 мс: в 33 раза больше. Это и есть разница между «разряжается» и
# «разряжается пачкой».
#
# Моменты LIF пересняты после #568 (было 52.5 / 202.5 / 352.5 мс). До той
# правки событийный стимул доставлялся дважды, источник толчков добирал до
# порога вдвое быстрее написанного, и весь прогон шёл на 0.6 мс раньше. То,
# ради чего пример написан, не сдвинулось ни на число: те же 3 спайка против
# 15, те же три пачки по 5, тот же интервал 3.4-4.1 мс внутри пачки против
# 135 мс между ними и та же развёртка по b (132, 125, 37, 15 спайков).
#
# Что пачку кончает именно ток адаптации, показывает развёртка по b:
# vnl data examples/adex_burst.vnl --sweep "burster.b=0pA,20pA,60pA,120pA"
#   ->  BURST: 132, 125, 37, 15 спайков. При b = 0 останавливать пачку нечем,
#       и первый же толчок разгоняет клетку до конца прогона: 132 спайка -- это
#       500 мс, поделённые на рефрактерность, то есть максимум, который клетка
#       вообще может выдать.

model adex_burst

cell relay : excitatory, glutamate {
    tau_m      = 8ms
    threshold  = -50mV
    refractory = 3ms
}

# Контроль: прежняя точечная модель. Вид указан явно, хотя он и по умолчанию --
# в файле про сравнение двух видов молчание читалось бы как недосмотр.
cell plain : excitatory, glutamate {
    point      = lif
    tau_m      = 10ms
    threshold  = -50mV
    refractory = 3ms
}

cell burster : excitatory, glutamate {
    point      = adex
    tau_m      = 10ms
    v_rest     = -65mV
    v_t        = -50mV      # с этого потенциала начинается разгон
    delta_t    = 2mV        # на 2 мВ выше v_t собственный ток растёт в e раз
    v_peak     = -40mV      # здесь разряд признан состоявшимся
    v_reset    = -43mV      # выше v_t: после разряда клетка снова разгоняется
    refractory = 3ms
    tau_w      = 40ms       # за сколько рассасывается ток адаптации
    a          = 2nS        # подпороговая связь тока с потенциалом
    b          = 120pA      # прибавка к току на разряд -- то, чем кончается пачка
}

neuron IN    : relay
neuron LIF   : plain
neuron BURST : burster

IN.soma -> LIF.soma {
    receptor = ampa
    weight   = 3.2nS
    delay    = 1.0ms
}

IN.soma -> BURST.soma {
    receptor = ampa
    weight   = 3.2nS
    delay    = 1.0ms
}

stim drive -> IN.soma : spikes weight=3nS times="50 200 350"

record LIF.soma.v
record BURST.soma.v
record LIF.soma.spikes
record BURST.soma.spikes

run { dt = 0.1ms  duration = 500ms  level = L1  seed = 1 }
