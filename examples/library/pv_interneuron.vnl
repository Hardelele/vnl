# Корзинчатый интернейрон PV (PV basket interneuron).
#
# Одиночная клетка как блок: быстрая тормозная клетка, которой гасят соседей.
# Короткая tau_m (6 мс), низкий порог (-52 мВ) и рефрактерность 1 мс -- отсюда
# fast-spiking: она успевает ответить внутри окна интеграции пирамиды, и именно
# на этом стоят FFI и торможение с обратной связью.
#
# Что видно на прогоне (ЧИСЛО): на том же драйве, что и остальные одиночные
# клетки, PV даёт 89 спайков (222 Гц) -- в 4.5 раза больше пирамиды, при
# межспайковом интервале 2.7 мс против её 13.6 мс.#
# Драйв у всех пяти одиночных клеток библиотеки одинаковый -- пуассоновский
# 250 Гц, вес 1.6 нСм, seed 7, 400 мс, -- поэтому числа на карточках сравнимы
# между собой: PV 89 спайков, VIP 61, SST 56, релейная 39, пирамида 20.

model pv_interneuron

cell pv : inhibitory, gaba {
    tau_m      = 6ms
    threshold  = -52mV
    refractory = 1ms
}

neuron PV : pv

stim drive -> PV.soma : poisson rate=250Hz weight=1.6nS start=20ms stop=380ms

record PV.soma.spikes
record PV.soma.v
record PV.soma.g_exc

run { dt = 0.1ms  duration = 400ms  level = L1  seed = 7 }
