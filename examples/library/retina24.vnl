# Сетчатка 24x24: граница, за которой изображение кончается (#580).
#
# Блок библиотеки, который вставляют в схему, когда сеть должна на что-то
# смотреть. Внутри две вещи и ни одной лишней: поле сенсоров 24x24 и слой из
# 576 клеток, каждая со своим пикселем.
#
# Клетки здесь не для красоты. Сенсор -- дверь, и подключиться к ней снаружи
# блока нечем: порт паттерна ссылается на точку клетки, а у двери точек нет.
# Слой и есть то, чем сетчатка говорит наружу: 576 портов `out[строка,столбец]`,
# по одному на пиксель. Кто их читает -- дело схемы, в которую блок вставлен.
#
# Дальше изображение никак особенно не обрабатывается: за портами стоят
# обычные аксоны и синапсы, и то, что вход пришёл с картинки, им безразлично.
# Различать формы, считать свет, ловить движение -- всё это схемы, которые
# ставят за сетчаткой, а не свойства входа.
#
# Величину подают программой:
#
#   vnl run examples/library/retina24.vnl --source eye="python tools/letters.py T"
#
# Прямо так блок и проверяют: 158 клеток из 576 разряжаются (столько в букве T
# светящихся пикселей), по 28 спайков каждая при яркости 1. Кадр буквы даёт
# `tools/letters.py`, кадр картинки -- `tools/eye.py`, кадр экрана --
# `tools/screen.py`; для блока разницы между ними нет.

model retina24

cell photoreceptor : excitatory, glutamate {
    tau_m      = 10ms
    threshold  = -50mV
    refractory = 2ms
}

neuron R[24x24] : photoreceptor

sensor eye : rate { grid = 24x24, channels = gray, to = 100Hz }

eye -> R.soma { receptor = ampa, weight = 2nS, delay = 1.0ms }

record R[12,12].soma.v

# Заявленное число здесь одно, и оно про молчание: без поданной величины поле
# не выдумывает себе вход, а слой за ним -- разрядов. Сказать больше этот блок
# и не может: величина -- вход прогона, а не свойство схемы, и сверка
# библиотеки (#501) гоняет схему как есть, ничего ей не подавая.
#
# Числа с буквой -- 158 ответивших клеток, по 28 спайков -- проверяются там,
# где кадр есть чем подать: `tests/test_vision.py` запускает `tools/letters.py`
# и сверяет прогон с ним.
expect {
    R[12,12].spikes = 0
}

run { dt = 0.1ms  duration = 300ms  level = L1  seed = 1 }
