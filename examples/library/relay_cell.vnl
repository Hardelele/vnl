# Релейная клетка (relay cell).
#
# Одиночная клетка как блок: передатчик без своего характера. Нужна там, где
# нужен источник спайков -- вход схемы, драйв мотива, источник модулятора.
# Ничего не адаптирует и ничего не тормозит: 8 мс на постоянную времени,
# рефрактерность 4 мс.
#
# Что видно на прогоне (ЧИСЛО): на драйве 250 Гц релейная клетка даёт
# 39 спайков (97.5 Гц) с ровным межспайковым интервалом 7.4 мс -- частота
# следует за входом и не уползает, в отличие от пирамиды (20 спайков).#
# Драйв у всех пяти одиночных клеток библиотеки одинаковый -- пуассоновский
# 250 Гц, вес 1.6 нСм, seed 7, 400 мс, -- поэтому числа на карточках сравнимы
# между собой: PV 89 спайков, VIP 61, SST 56, релейная 39, пирамида 20.

model relay_cell

cell relay : excitatory, glutamate {
    tau_m      = 8ms
    threshold  = -50mV
    refractory = 4ms
}

neuron IN : relay

stim drive -> IN.soma : poisson rate=250Hz weight=1.6nS start=20ms stop=380ms

record IN.soma.spikes
record IN.soma.v
record IN.soma.g_exc

run { dt = 0.1ms  duration = 400ms  level = L1  seed = 7 }
