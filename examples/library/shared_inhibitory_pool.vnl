# Общий тормозный пул (shared inhibitory pool).
#
# Мотив из четырёх клеток: три возбуждающих канала кормят одну тормозную клетку,
# и она возвращает торможение всем трём. Никто никого не выбирает, но бюджет
# активности общий: чем больше каналов работает, тем меньше достаётся каждому.
# Убери пул -- каналы перестанут друг о друге знать.
#
# Демонстрация устроена окнами одного прогона: до 250 мс работает только E1,
# после 250 мс к нему присоединяются E2 и E3 с тем же драйвом 260 Гц.
#
# Что видно на прогоне (ЧИСЛА): E1 в одиночку идёт на 66.7 Гц (10 спайков за
# окно 50-200 мс), в компании двух соседей -- на 40 Гц (8 спайков за окно
# 260-460 мс): чужая активность срезала его выход в 1.7 раза, хотя его
# собственный вход не изменился. Суммарно по каналам 66.7 Гц против 95 Гц при
# втрое большем числе работающих каналов -- вместо 200 Гц, которые дали бы три
# независимых канала. Это и есть общий бюджет.

model shared_inhibitory_pool

cell chan : excitatory, glutamate { tau_m = 12ms  threshold = -50mV  refractory = 3ms }
cell pool : inhibitory, gaba      { tau_m = 8ms   threshold = -52mV  refractory = 1ms }

neuron E1   : chan
neuron E2   : chan
neuron E3   : chan
neuron POOL : pool

E1.soma -> POOL.soma { receptor = ampa  weight = 2.5nS  delay = 1.0ms }
E2.soma -> POOL.soma { receptor = ampa  weight = 2.5nS  delay = 1.0ms }
E3.soma -> POOL.soma { receptor = ampa  weight = 2.5nS  delay = 1.0ms }

POOL.soma -> E1.soma { receptor = gaba_a  weight = 6.0nS  delay = 1.2ms }
POOL.soma -> E2.soma { receptor = gaba_a  weight = 6.0nS  delay = 1.2ms }
POOL.soma -> E3.soma { receptor = gaba_a  weight = 6.0nS  delay = 1.2ms }

stim drive_1 -> E1.soma : poisson rate=260Hz weight=1.6nS start=20ms  stop=460ms
stim drive_2 -> E2.soma : poisson rate=260Hz weight=1.6nS start=250ms stop=460ms
stim drive_3 -> E3.soma : poisson rate=260Hz weight=1.6nS start=250ms stop=460ms

record E1.soma.spikes
record E1.soma.g_inh
record POOL.soma.spikes

run { dt = 0.1ms  duration = 470ms  level = L1  seed = 17 }
