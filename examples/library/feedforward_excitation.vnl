# Возбуждение с опережением (feedforward excitation), цепочка A -> B -> C.
#
# Мотив из трёх клеток: сигнал идёт вперёд и только вперёд. Убери B -- связь
# между A и C исчезнет: смысл здесь во взаимодействии, а не в одном контакте.
# Это база для линий задержки и цепочек последовательной активации.
#
# Что видно на прогоне (ЧИСЛО): 8 входных событий проходят всю цепочку без
# потерь -- A 8, B 8, C 8 спайков. Каждое звено добавляет 3.4 мс: первый спайк
# A на 21.0 мс, B на 24.4, C на 27.8. Задержка цепочки складывается из звеньев,
# и это видно числом.
#
# Моменты пересняты после #568 (было 20.4 / 23.8 / 27.2 мс). До той правки
# событийный стимул доставлялся дважды, и первая клетка цепочки набирала порог
# вдвое быстрее написанного; теперь A разряжается на 0.6 мс позже, и вся
# цепочка сдвигается за ней целиком. Само измеряемое здесь -- добавка звена --
# не изменилось вовсе: те же 3.4 мс на звено, потому что задержку даёт контакт,
# а не драйв.

model feedforward_excitation

cell relay : excitatory, glutamate {
    tau_m      = 8ms
    threshold  = -50mV
    refractory = 4ms
}

cell target : excitatory, glutamate {
    tau_m      = 10ms
    threshold  = -50mV
    refractory = 4ms
}

neuron A : relay
neuron B : target
neuron C : target

A.soma -> B.soma {
    receptor = ampa
    weight   = 2.2nS
    delay    = 1.0ms
}

B.soma -> C.soma {
    receptor = ampa
    weight   = 2.2nS
    delay    = 1.0ms
}

stim drive -> A.soma : spikes weight=3nS times="20 60 100 140 180 220 260 300"

record A.soma.spikes
record B.soma.spikes
record C.soma.spikes
record C.soma.v

run { dt = 0.1ms  duration = 340ms  level = L1  seed = 1 }

# Заявленное шапкой -- машинно: числа сверяются прогоном (#501).
expect {
    A.spikes = 8
    B.spikes = 8
    C.spikes = 8
    A.first_spike = 21.0ms
    B.first_spike = 24.4ms
    C.first_spike = 27.8ms
}
