# Интернейрон SST (SST interneuron).
#
# Одиночная клетка как блок: тормозная клетка, которая в коре садится на
# дендриты пирамиды, а не на сому, -- медленнее PV (tau_m 10 мс, рефрактерность
# 2 мс). Это та клетка, которую снимает VIP в мотиве растормаживания.
#
# Что видно на прогоне (ЧИСЛО): на том же драйве SST даёт 56 спайков (140 Гц)
# при межспайковом интервале 4.7 мс -- заметно реже PV (89 спайков, 2.7 мс) и
# втрое чаще пирамиды.#
# Драйв у всех пяти одиночных клеток библиотеки одинаковый -- пуассоновский
# 250 Гц, вес 1.6 нСм, seed 7, 400 мс, -- поэтому числа на карточках сравнимы
# между собой: PV 89 спайков, VIP 61, SST 56, релейная 39, пирамида 20.

model sst_interneuron

cell sst : inhibitory, gaba {
    tau_m      = 10ms
    threshold  = -52mV
    refractory = 2ms
}

neuron SST : sst

stim drive -> SST.soma : poisson rate=250Hz weight=1.6nS start=20ms stop=380ms

record SST.soma.spikes
record SST.soma.v
record SST.soma.g_exc

run { dt = 0.1ms  duration = 400ms  level = L1  seed = 7 }
