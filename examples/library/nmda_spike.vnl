# Нелинейное дендритное интегрирование, NMDA-спайк (NMDA plateau potential).
#
# Мотив из семи клеток: четыре входа сходятся на трёх одинаково устроенных
# приёмниках. На EA они сидят через ampa, на EN и EB -- через nmda. Веса
# подобраны так, что одиночный вход не проходит нигде и даёт на обоих почти
# один и тот же EPSP: 3.30 мВ над покоем у EA и 3.22 мВ у EN.
#
# Разница между ampa и nmda не в скорости спада, а в том, что у nmda канал
# забит магнием, и вытолкнуть магний может только деполяризация. Поэтому вклад
# ampa с приближением к порогу убывает -- движущая сила (E − v) тает, -- а
# вклад nmda растёт: растущий множитель Джара--Стивенса B(v) её перебивает.
# Отсюда положительная обратная связь, а из неё -- всё остальное.
#
# Внутри прогона три события: один вход на 100 мс, три совпавших на 350 мс,
# четыре совпавших на 700 мс. Сравнение живёт внутри одного прогона.
#
# Что видно на прогоне (ЧИСЛО) -- пик отклика над покоем и отношение к
# «N x одиночный» (единица означала бы ровное сложение):
#
#             AMPA (EA)           NMDA (EN)          плато EN   спайки EB
#   1 вход    3.30 мВ (x1.00)     3.22 мВ (x1.00)      0.0 мс       0
#   3 входа   9.32 мВ (x0.94)    14.29 мВ (x1.48)      0.0 мс       0
#   4 входа  12.07 мВ (x0.91)    24.63 мВ (x1.91)     65.7 мс       2
#
# У AMPA отношение не растёт, а слегка падает: это насыщение к реверсалу 0 мВ,
# то есть нелинейность обратного знака -- чем ближе клетка к порогу, тем меньше
# приносит следующий вход. У NMDA оно доходит до 1.91: четыре совпавших входа
# дают вдвое больше, чем те же четыре порознь.
#
# Порог по числу совпавших входов виден там же: три совпавших не поднимают EN
# выше -50 мВ вовсе и не дают EB ни одного спайка, четыре дают плато на 65.7 мс
# и два спайка.
#
# Плато -- вторая половина механизма. Сам вход длится один шаг, AMPA-ответ
# рассасывается за единицы миллисекунд, а EN держится выше -50 мВ 65.7 мс: ток
# держит сам себя, пока проводимость не спадёт. На EB то же самое видно
# спайками -- после одного совпадения он даёт не разряд, а короткую пачку.
#
# Развёртка по весу четвёртого NMDA-контакта показывает не плавный рост, а
# разрыв:
# vnl data examples/library/nmda_spike.vnl --sweep "m4.weight=0,0.1,0.2,0.4,0.95"
#   ->  пик EN 14.39, 15.25, 16.16, 18.12, 24.63 мВ; время выше -50 мВ
# 0.0, 11.5, 24.5, 39.5, 65.7 мс. Первая же добавка поднимает пик на 0.86 мВ --
# на шесть процентов, -- а надпороговое время прыгает с нуля до 11.5 мс. Ответ
# меняется не пропорционально входу, и это ровно то, чего линейным синапсом не
# получить ни при каком весе.
#
# Устойчивость: при dt = 0.05 мс те же числа (пики EN 3.21 / 14.29 / 24.63 мВ,
# плато 65.7 мс) -- расхождение в сотых долях милливольта и только на AMPA.
# Регенеративный ток -- прямой путь к расходимости явной схемы, поэтому солвер
# проверяет условие устойчивости на каждом шаге и отказывается считать вслух,
# называя нужный dt, а не выдаёт мусор в трассе.
#
# Почему у EA и EN порог отодвинут к -20 мВ. Опыт про то, как складываются
# входы на мембране, и разряд его бы оборвал: сброс к -65 мВ стирает ровно ту
# деполяризацию, которая и есть ответ. Клетка с обычным порогом в схеме тоже
# есть -- это EB, и по ней видно, во что нелинейность превращается на выходе.
#
# Чего здесь нет: отдельной ветви. В точечной клетке NMDA-плато охватывает всю
# мембрану, а не участок дендрита, поэтому «вход проходит только при совпадении
# с другим входом на той же ветви» этим мотивом не выражается -- для него нужна
# компартментная модель, и `Dendritic gate` остаётся вариантом без ветвей.

model nmda_spike

cell relay : excitatory, glutamate {
    tau_m      = 8ms
    threshold  = -50mV
    refractory = 4ms
}

cell reader : excitatory, glutamate {
    tau_m     = 10ms
    threshold = -20mV
}

cell pyr : excitatory, glutamate {
    tau_m      = 10ms
    threshold  = -50mV
    refractory = 5ms
}

neuron IN1 : relay
neuron IN2 : relay
neuron IN3 : relay
neuron IN4 : relay
neuron EA  : reader
neuron EN  : reader
neuron EB  : pyr

stim s1 -> IN1.soma : spikes weight=3nS times="100 350 700"
stim s2 -> IN2.soma : spikes weight=3nS times="350 700"
stim s3 -> IN3.soma : spikes weight=3nS times="350 700"
stim s4 -> IN4.soma : spikes weight=3nS times="700"

IN1.soma -> EA.soma { id = a1  receptor = ampa  weight = 0.4nS  delay = 1.0ms }
IN2.soma -> EA.soma { id = a2  receptor = ampa  weight = 0.4nS  delay = 1.0ms }
IN3.soma -> EA.soma { id = a3  receptor = ampa  weight = 0.4nS  delay = 1.0ms }
IN4.soma -> EA.soma { id = a4  receptor = ampa  weight = 0.4nS  delay = 1.0ms }

IN1.soma -> EN.soma { id = m1  receptor = nmda  weight = 0.95nS  delay = 1.0ms }
IN2.soma -> EN.soma { id = m2  receptor = nmda  weight = 0.95nS  delay = 1.0ms }
IN3.soma -> EN.soma { id = m3  receptor = nmda  weight = 0.95nS  delay = 1.0ms }
IN4.soma -> EN.soma { id = m4  receptor = nmda  weight = 0.95nS  delay = 1.0ms }

IN1.soma -> EB.soma { id = n1  receptor = nmda  weight = 0.95nS  delay = 1.0ms }
IN2.soma -> EB.soma { id = n2  receptor = nmda  weight = 0.95nS  delay = 1.0ms }
IN3.soma -> EB.soma { id = n3  receptor = nmda  weight = 0.95nS  delay = 1.0ms }
IN4.soma -> EB.soma { id = n4  receptor = nmda  weight = 0.95nS  delay = 1.0ms }

record EA.soma.v
record EN.soma.v
record EN.soma.g_exc
record EB.soma.spikes

run { dt = 0.1ms  duration = 1100ms  level = L1  seed = 1 }

# Заявленное шапкой -- машинно: числа сверяются прогоном (#501).
expect {
    EA.soma.v.max = 3.30mV  base=-65mV start=100ms stop=350ms
    EN.soma.v.max = 3.22mV  base=-65mV start=100ms stop=350ms
    EA.soma.v.max = 9.32mV  base=-65mV start=350ms stop=700ms
    EN.soma.v.max = 14.29mV base=-65mV start=350ms stop=700ms
    EA.soma.v.max = 12.07mV base=-65mV start=700ms stop=1100ms
    EN.soma.v.max = 24.63mV base=-65mV start=700ms stop=1100ms
    EN.soma.v.time_above = 0.0ms  level=-50mV start=350ms stop=700ms
    EN.soma.v.time_above = 65.7ms level=-50mV start=700ms stop=1100ms
    EB.spikes = 0 start=100ms stop=350ms
    EB.spikes = 0 start=350ms stop=700ms
    EB.spikes = 2 start=700ms stop=1100ms
    sweep "m4.weight=0,0.1,0.2,0.4,0.95" EN.soma.v.max = 14.39, 15.25, 16.16, 18.12, 24.63  base=-65mV start=700ms stop=1100ms
    sweep "m4.weight=0,0.1,0.2,0.4,0.95" EN.soma.v.time_above = 0.0, 11.5, 24.5, 39.5, 65.7  level=-50mV start=700ms stop=1100ms
}
