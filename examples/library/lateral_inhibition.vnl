# Латеральное торможение (lateral inhibition).
#
# Мотив из шести клеток, три канала: каждый канал кормит свою тормозную клетку,
# а та давит соседей -- не себя. Сильный канал этим подавляет слабых, и разница
# между каналами на выходе оказывается больше, чем на входе: это усиление
# контраста, а не просто ограничение активности.
#
# Три канала, а не тридцать: тридцать -- это уже сеть и другой уровень.
# Соседство здесь линейное: сосед первого -- второй, у второго соседи первый и
# третий, у третьего -- второй.
#
# Что видно на прогоне (ЧИСЛО): драйв центра выше фланговых всего в 1.5 раза
# (300 Гц против 200 Гц), а выход расходится в 6.4 раза -- P2 даёт 35 спайков,
# P1 6 и P3 5. Контраст на выходе больше контраста на входе в 4 раза: это и
# есть работа мотива.

model lateral_inhibition

cell chan : excitatory, glutamate { tau_m = 12ms  threshold = -50mV  refractory = 3ms }
cell basket : inhibitory, gaba    { tau_m = 6ms   threshold = -52mV  refractory = 1ms }

neuron P1 : chan
neuron P2 : chan
neuron P3 : chan
neuron I1 : basket
neuron I2 : basket
neuron I3 : basket

P1.soma -> I1.soma { receptor = ampa  weight = 3.0nS  delay = 1.0ms }
P2.soma -> I2.soma { receptor = ampa  weight = 3.0nS  delay = 1.0ms }
P3.soma -> I3.soma { receptor = ampa  weight = 3.0nS  delay = 1.0ms }

I1.soma -> P2.soma { receptor = gaba_a  weight = 4.0nS  delay = 1.2ms }
I2.soma -> P1.soma { receptor = gaba_a  weight = 4.0nS  delay = 1.2ms }
I2.soma -> P3.soma { receptor = gaba_a  weight = 4.0nS  delay = 1.2ms }
I3.soma -> P2.soma { receptor = gaba_a  weight = 4.0nS  delay = 1.2ms }

stim edge_1   -> P1.soma : poisson rate=200Hz weight=1.6nS start=20ms stop=380ms
stim centre_2 -> P2.soma : poisson rate=300Hz weight=1.6nS start=20ms stop=380ms
stim edge_3   -> P3.soma : poisson rate=200Hz weight=1.6nS start=20ms stop=380ms

record P1.soma.spikes
record P2.soma.spikes
record P3.soma.spikes
record P1.soma.g_inh

run { dt = 0.1ms  duration = 400ms  level = L1  seed = 13 }

# Заявленное шапкой -- машинно: числа сверяются прогоном (#501).
expect {
    P1.spikes = 6
    P2.spikes = 35
    P3.spikes = 5
}
