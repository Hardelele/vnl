# Отдача после торможения (post-inhibitory rebound): adex против adex без
# подпорогового тока.
#
# Пример, а не паттерн библиотеки: показывается свойство одной клетки. Схема
# взята самая короткая, какая позволяет сравнить -- один тормозный нейрон и две
# одинаковые клетки под ним.
#
# Торможение само по себе разряда не вызывает никогда: оно уводит мембрану от
# порога, а не к нему. У LIF после снятия торможения потенциал возвращается к
# покою монотонно, и перерегулирования не бывает в принципе -- единственный
# внутренний ток там тянет к покою.
#
# Отдачу делает подпороговая связь тока адаптации с потенциалом, параметр a.
# При a > 0 ток следит за потенциалом: гиперполяризация уводит w в минус, а
# минус в w -- это деполяризующий ток. Пока идёт торможение, он только частично
# его гасит и разряда не даёт. Но мембрана возвращается к покою за tau_m = 10 мс,
# а w рассасывается за tau_w = 60 мс, и в этом зазоре деполяризующий ток
# остаётся без торможения, которое его вызвало. Мембрана перелетает покой и
# доходит до v_t, а выше v_t срабатывает экспоненциальный разгон и доводит дело
# до разряда.
#
# Клетки REB и FLAT отличаются ровно одним числом: a = 50 нСм против a = 0 нСм.
# Всё остальное -- вид модели, порог, покой, постоянная времени, tau_w, вес и
# рецептор тормозного входа -- у них одинаково.
#
# Клетка низкопороговая (v_t на 5 мВ выше покоя). Это не подгонка под пример, а
# та самая клетка, на которой отдачу описывают: релейные нейроны таламуса.
#
# Что видно на прогоне (ЧИСЛА): торможение работает с 100 до 200 мс и уводит
# мембрану REB до -69.6 мВ. Во время торможения ни один из двух не разряжается.
# После снятия REB даёт 1 спайк на 236.6 мс -- через 36 мс после того, как
# торможение кончилось, и без всякого возбуждающего входа. FLAT не даёт ни
# одного и после снятия торможения выше -64.8 мВ не поднимается. 1 против 0.
#
# Что дело именно в a, показывает развёртка по нему:
# vnl data examples/adex_rebound.vnl --sweep "rebound.a=0nS,20nS,35nS,50nS"
#   ->  REB: 0, 0, 0, 1 спайк, а перелёт над покоем после снятия торможения --
#       -64.8, -61.1, -58.6, -51.1 мВ. Отдача растёт с a непрерывно и появляется
#       задолго до первого спайка; до v_t = -60 мВ она добирает к 35 нСм, а до
#       разряда -- к 50 нСм.

model adex_rebound

cell pv : inhibitory, gaba {
    tau_m      = 6ms
    threshold  = -52mV
    refractory = 1ms
}

cell rebound : excitatory, glutamate {
    point      = adex
    tau_m      = 10ms
    v_rest     = -65mV
    v_t        = -60mV      # низкопороговая клетка: до разгона 5 мВ
    delta_t    = 2mV
    v_peak     = -50mV
    v_reset    = -65mV      # ниже v_t: пачки тут не нужно, нужен один спайк
    refractory = 3ms
    tau_w      = 60ms       # медленнее мембраны -- в этом зазоре и живёт отдача
    a          = 50nS       # то самое, из-за чего отдача есть
    b          = 0pA        # на спайк ток не прибавляется: мешало бы читать
}

# Контроль: та же клетка с a = 0. Ток адаптации перестаёт следить за
# потенциалом, то есть перестаёт существовать -- и отдаче взяться неоткуда.
cell flat : excitatory, glutamate {
    point      = adex
    tau_m      = 10ms
    v_rest     = -65mV
    v_t        = -60mV
    delta_t    = 2mV
    v_peak     = -50mV
    v_reset    = -65mV
    refractory = 3ms
    tau_w      = 60ms
    a          = 0nS
    b          = 0pA
}

neuron INH  : pv
neuron REB  : rebound
neuron FLAT : flat

INH.soma -> REB.soma {
    receptor = gaba_a
    weight   = 6nS
    delay    = 1.0ms
}

INH.soma -> FLAT.soma {
    receptor = gaba_a
    weight   = 6nS
    delay    = 1.0ms
}

stim drive -> INH.soma : poisson rate=500Hz weight=3nS start=100ms stop=200ms

record REB.soma.v
record FLAT.soma.v
record REB.soma.spikes
record FLAT.soma.spikes
record REB.soma.g_inh

run { dt = 0.1ms  duration = 400ms  level = L1  seed = 3 }
